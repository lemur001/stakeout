# Local dashboard: no credentials or live sending required.
APP_MODE=local
HOST=127.0.0.1
PORT=8080
APP_URL=http://127.0.0.1:8080
RUN_WORKER=true
ALLOW_LIVE_SEND=false

# Railway: use scripts/generate_deploy_env.py and docs/RAILWAY.md.
# Keep these three independent random values in sealed Railway variables.
# ENCRYPTION_KEY=base64-encoded-random-32-bytes
# APP_SECRET=random-48-bytes-url-safe
# SETUP_TOKEN=random-48-bytes-url-safe
# DATABASE_PATH=/app/data/civic.sqlite3
# Optional PostgreSQL replaces SQLite; keep its URL server-side.
# DATABASE_URL=postgresql://...
# ENCRYPTION_KEY_PREVIOUS=previous-key-during-rotation-only
