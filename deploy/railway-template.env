# Railway TEMPLATE variables, evaluated separately for each deployment.
# These are generation expressions, not credentials. Do not use this as an
# application .env file or paste these expressions into a running service.
APP_MODE=production
HOST=0.0.0.0
PORT=8080
DATABASE_PATH=/app/data/civic.sqlite3
RUN_WORKER=true
ALLOW_LIVE_SEND=false
APP_SECRET=${{secret(64)}}
ENCRYPTION_KEY=${{secret(43, "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789+/")}}=
SETUP_TOKEN=${{secret(64)}}
